{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "information_for_contributors": [
    "GENERATED FILE — DO NOT EDIT.",
    "Element keywords are derived from @wireweave/core/spec (itself extracted from wireframe.peggy).",
    "Attribute and value keywords are derived from @wireweave/language-data.",
    "Run `pnpm build:syntax` in packages/vscode-extension after changing the grammar."
  ],
  "name": "Wireframe",
  "scopeName": "source.wireframe",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#elements"
    },
    {
      "include": "#block-keywords"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#value-keywords"
    },
    {
      "include": "#brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wireframe",
          "match": "//.*$"
        },
        {
          "name": "comment.block.wireframe",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wireframe",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wireframe",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.wireframe",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.wireframe",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.wireframe",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.wireframe",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "elements": {
      "patterns": [
        {
          "name": "keyword.control.structure.wireframe",
          "match": "\\b(layout|component|use|slot|repeat)\\b(?!-)"
        },
        {
          "name": "keyword.control.layout.wireframe",
          "match": "\\b(page|header|main|footer|sidebar|section|row|col|stack|relative|divider)\\b(?!-)"
        },
        {
          "name": "support.class.component.container.wireframe",
          "match": "\\b(card|modal|drawer|accordion)\\b(?!-)"
        },
        {
          "name": "support.class.component.text.wireframe",
          "match": "\\b(text|title|link)\\b(?!-)"
        },
        {
          "name": "support.class.component.input.wireframe",
          "match": "\\b(input|textarea|select|checkbox|radio|switch|slider|button)\\b(?!-)"
        },
        {
          "name": "support.class.component.display.wireframe",
          "match": "\\b(image|placeholder|avatar|badge|icon)\\b(?!-)"
        },
        {
          "name": "support.class.component.data.wireframe",
          "match": "\\b(table|list)\\b(?!-)"
        },
        {
          "name": "support.class.component.feedback.wireframe",
          "match": "\\b(alert|toast|progress|spinner)\\b(?!-)"
        },
        {
          "name": "support.class.component.overlay.wireframe",
          "match": "\\b(tooltip|popover|dropdown)\\b(?!-)"
        },
        {
          "name": "support.class.component.nav.wireframe",
          "match": "\\b(nav|tabs|breadcrumb)\\b(?!-)"
        },
        {
          "name": "support.class.component.annotation.wireframe",
          "match": "\\b(marker|annotations|item)\\b(?!-)"
        }
      ]
    },
    "block-keywords": {
      "patterns": [
        {
          "name": "keyword.control.block.wireframe",
          "match": "\\b(columns|tab|group|fill)\\b(?!-)"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "variable.parameter.wireframe",
          "match": "\\b(action|active|align|alt|anchor|aria|aria-label|at|bg|bold|border|bordered|centered|checked|color|danger|device|direction|disabled|dismissible|enabledWhen|expanded|external|flex|gap|ghost|h|height|hover|href|icon|id|indeterminate|inputType|justify|label|level|lg|loading|m|max|maxH|maxW|mb|md|min|minH|minW|ml|mr|mt|muted|mx|my|name|navigate|none|on|opens|order|ordered|outline|p|pb|pill|pl|placeholder|position|pr|primary|pt|px|py|readonly|required|rounded|rows|scroll|secondary|shadow|size|sm|span|src|states|step|striped|title|toggles|type|uses|value|variant|variants|vertical|viewport|visibleWhen|w|weight|when|width|wrap|x|xl|y)\\b(?!-)"
        }
      ]
    },
    "value-keywords": {
      "patterns": [
        {
          "name": "constant.language.wireframe",
          "match": "\\b(2xl|3xl|android|android-lg|around|auto|base|baseline|between|blue|bottom|bottom-center|bottom-left|bottom-right|center|center-left|center-right|column|column-reverse|date|default|desktop|desktop-lg|desktop-sm|desktop-xl|email|end|evenly|fit|full|green|info|ipad|ipad-portrait|ipad-pro|ipad-pro-portrait|iphone-se|iphone14|iphone14-pro|iphone14-pro-max|left|medium|normal|nowrap|number|orange|password|purple|red|right|row-reverse|screen|search|semibold|start|stretch|success|tel|top|top-center|top-left|top-right|url|warning|xs|yellow)\\b(?!-)"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.definition.block.wireframe",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.array.wireframe",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.definition.parameters.wireframe",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.wireframe",
          "match": "[,:]"
        },
        {
          "name": "keyword.operator.assignment.wireframe",
          "match": "="
        }
      ]
    }
  }
}
