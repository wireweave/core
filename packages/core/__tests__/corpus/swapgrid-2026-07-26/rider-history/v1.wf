page "이용내역" viewport="375x812" {
  header h=80 p=4 {
    row align=center justify=between {
      title "이용내역" level=1 size=md
      button "" action=filter-custom aria="기간 선택" ghost icon=calendar size=sm
    }
  }
  main p=4 scroll {
    col gap=4 {
      card p=3 {
        col gap=2 {
          row align=center gap=2 {
            badge "이번 달" action=filter-this-month pill primary
            badge "지난 달" action=filter-last-month pill
            badge "기간 선택" action=filter-custom pill
          }
          row align=center justify=between {
            text "2026년 7월" muted size=sm
            text "교환 12회" size=sm weight=semibold
          }
        }
      }
      section "7월 26일 (오늘)" {
        col gap=2 {
          card "강남 교환소" action=collapse-entry p=3 {
            row align=center justify=between {
              text "14:32 · A규격 · 98%" muted size=sm
              icon "chevron-up" muted size=sm
            }
          }
          card p=3 {
            col gap=1 {
              row align=center justify=between {
                text "반납" muted size=sm
                text "SG-A-004821" size=sm weight=medium
              }
              row align=center justify=between {
                text "수령" muted size=sm
                text "SG-A-007193" size=sm weight=medium
              }
              row align=center justify=between {
                text "결과" muted size=sm
                badge "완료" action=none pill success
              }
            }
          }
        }
      }
      section "7월 25일" {
        col gap=2 {
          card "왕십리 교환소" action=expand-entry p=3 {
            row align=center justify=between {
              row align=center gap=2 {
                text "13:12" muted size=sm
                badge "미완결" action=none pill warning
              }
              icon "chevron-down" muted size=sm
            }
          }
          card "성수 교환소" action=expand-entry p=3 {
            row align=center justify=between {
              text "08:20 · A규격 · 97%" muted size=sm
              icon "chevron-down" muted size=sm
            }
          }
        }
      }
      button "더 불러오기" action=load-more outline w=full
    }
  }
  footer h=80 p=2 {
    nav {
      item "지도" icon=map navigate="교환소 지도"
      item "내 예약" icon=ticket navigate="내 예약"
      item "이용내역" action=none active icon=receipt
      item "설정" icon=settings navigate="설정"
    }
  }
}
