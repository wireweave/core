page "Bookmark" width=375 height=812 {
  header h=56 border {
    row justify=between align=center px=4 py=2 {
      title "Bookmark" level=4
      icon "settings" size=lg
    }
  }
  main scroll p=4 gap=6 {
    col gap=4 {
      card p=4 {
        placeholder "Book Cover" w=full h=200
        title "Book Title 1" level=4 mt=3
        text "Author Name 1" muted
        progress value=75 mt=3
      }
      card p=4 {
        placeholder "Book Cover" w=full h=200
        title "Book Title 2" level=4 mt=3
        text "Author Name 2" muted
        progress value=50 mt=3
      }
      card p=4 {
        placeholder "Book Cover" w=full h=200
        title "Book Title 3" level=4 mt=3
        text "Author Name 3" muted
        progress value=25 mt=3
      }
    }
  }
}