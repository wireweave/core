                                {
                                  "children": [
                                    {
                                      "content": "물론이죠! 다음은 Zustand와 React Query를 함께 사용하는 초기 설정 예제입니다.",
                                      "size": "sm",
                                      "type": "Text"
                                    },
                                    {
                                      "children": [
                                        {
                                          "children": [
                                            {
                                              "align": "center",
                                              "children": [
                                                {
                                                  "content": "store.ts",
                                                  "size": "sm",
                                                  "type": "Text",
                                                  "weight": "semibold"
                                                },
                                                {
                                                  "content": "",
                                                  "ghost": true,
                                                  "icon": "copy",
                                                  "size": "sm",
                                                  "type": "Button"
                                                }
                                              ],
                                              "justify": "between",
                                              "type": "Row"
                                            },
                                            {
                                              "content": "// Zustand store for UI state\nimport { create } from 'zustand'\n\ninterface UIState {\n  sidebarOpen: boolean\n  toggleSidebar: () => void\n}\n\nexport const useUIStore = create<UIState>((set) => ({\n  sidebarOpen: true,\n  toggleSidebar: () => set((s) => ({ sidebarOpen: !s.sidebarOpen }))\n}))",
                                              "size": "xs",
                                              "type": "Text"
